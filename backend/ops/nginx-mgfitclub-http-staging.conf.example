# Temporary pre-cutover test vhost. Keep only until a valid certificate exists.
# The public DNS remains unchanged while requests are sent directly to the VPS IP.
server {
    listen 80;
    listen [::]:80;
    server_name mgfitclub.ir www.mgfitclub.ir;
    root /opt/mgfitclub/current/site;
    index index.html;
    client_max_body_size 10m;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ^~ /api/api01/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }

    location ~ /\.(?!well-known/) {
        deny all;
    }

    # Revalidate HTML so releases appear immediately; long cache is for assets.
    location ~* \.html?$ {
        expires -1;
        try_files $uri =404;
    }

    # Compress text assets; binary images/models are cached but not recompressed.
    # Install deploy/nginx/mgfitclub-cache-map.conf under /etc/nginx/conf.d/;
    # its policy is one year for ?v= URLs and one week otherwise.
    location ~* \.(?:css|js|mjs|json|svg)$ {
        default_type application/javascript;
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
        expires $mgfitclub_static_expires;
        try_files $uri =404;
    }

    location ~* \.(?:avif|gif|jpe?g|png|webp|ico|woff2?|ttf|otf|glb)$ {
        expires $mgfitclub_static_expires;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
